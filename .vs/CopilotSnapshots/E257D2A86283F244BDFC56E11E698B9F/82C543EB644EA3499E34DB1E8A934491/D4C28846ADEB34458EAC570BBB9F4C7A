@page "/"
@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Login - METS Stock Replenishment</PageTitle>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <MudCard Style="width: 100%; max-width: 450px; padding: 32px;">
        <MudCardContent>
            <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6" Color="Color.Primary">
                <strong>METS</strong>
            </MudText>
            <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-8">Stock Replenishment</MudText>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-6" Variant="Variant.Filled" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <EditForm Model="@_loginModel" @ref="_editForm" OnSubmit="@HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_loginModel.Username"
                              Label="Username"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Class="mb-4"
                              Autocomplete="username"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person" />

                <MudTextField @bind-Value="_loginModel.Password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              InputType="@_showPassword"
                              Class="mb-4"
                              Autocomplete="current-password"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_hideIcon)"
                              OnAdornmentClick="@TogglePassword"
                              AdornmentClicked="true" />

                <MudCheckBox @bind-Value="_loginModel.RememberMe" Label="Remember me" Class="mb-6" />

                <MudButton OnClick="@HandleLogin"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@_isLoading"
                           Class="mb-6">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Logging in...</MudText>
                    }
                    else
                    {
                        <MudText>Login</MudText>
                    }
                </MudButton>
            </EditForm>

            <MudDivider Class="my-6" />

            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4">
                <strong>Demo Credentials:</strong>
            </MudText>

            <div style="background: #f5f5f5; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
                <MudText Typo="Typo.caption" Class="mb-2">
                    <strong>Worker Role</strong>
                </MudText>
                <MudText Typo="Typo.caption">
                    Username: <code>worker</code>
                </MudText>
                <MudText Typo="Typo.caption">
                    Password: <code>worker123</code>
                </MudText>
            </div>

            <div style="background: #f5f5f5; padding: 12px; border-radius: 4px;">
                <MudText Typo="Typo.caption" Class="mb-2">
                    <strong>Reviewer Role</strong>
                </MudText>
                <MudText Typo="Typo.caption">
                    Username: <code>reviewer</code>
                </MudText>
                <MudText Typo="Typo.caption">
                    Password: <code>reviewer123</code>
                </MudText>
            </div>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private EditForm _editForm;
    private LoginRequest _loginModel = new();
    private string _errorMessage = string.Empty;
    private bool _isLoading = false;
    private InputType _showPassword = InputType.Password;
    private string _hideIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated ?? false)
        {
            NavigationManager.NavigateTo("/requests", replace: true);
        }
    }

    private async Task HandleLogin()
    {
        _errorMessage = string.Empty;

        // Manually validate the form
        if (string.IsNullOrEmpty(_loginModel.Username) || string.IsNullOrEmpty(_loginModel.Password))
        {
            _errorMessage = "Username and password are required";
            return;
        }

        _isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", _loginModel);

            if (response.IsSuccessStatusCode)
            {
                // Force a full page reload to refresh authentication state from the server
                NavigationManager.NavigateTo("/requests", forceLoad: true);
            }
            else
            {
                var errorJson = await response.Content.ReadAsStringAsync();
                var errorContent = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                _errorMessage = errorContent?.Message ?? "Login failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void TogglePassword()
    {
        if (_showPassword == InputType.Password)
        {
            _showPassword = InputType.Text;
            _hideIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            _showPassword = InputType.Password;
            _hideIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    public class LoginRequest
    {
        [Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }

    public class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}


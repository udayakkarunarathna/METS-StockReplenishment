@page "/requests"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Stock Replenishment Requests</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Stock Replenishment Requests</MudText>

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_searchTerm" 
                              Label="Search" 
                              Placeholder="Search number, user, description..." 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              Clearable="true" 
                              Immediate="false"
                              OnClearButtonClick="@OnSearchCleared"
                              OnKeyDown="@OnSearchKeyDown" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="RequestStatus?" 
                           Label="Status" 
                           Value="_selectedStatus" 
                           ValueChanged="OnStatusChanged" 
                           Clearable="true"
                           OnClearButtonClick="OnStatusCleared">
                    <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)null)">All Statuses</MudSelectItem>
                    @foreach (var status in Enum.GetValues<RequestStatus>())
                    {
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)status)">@status</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="RequestPriority?" 
                           Label="Priority" 
                           Value="_selectedPriority" 
                           ValueChanged="OnPriorityChanged" 
                           Clearable="true"
                           OnClearButtonClick="OnPriorityCleared">
                    <MudSelectItem T="RequestPriority?" Value="@((RequestPriority?)null)">All Priorities</MudSelectItem>
                    @foreach (var priority in Enum.GetValues<RequestPriority>())
                    {
                        <MudSelectItem T="RequestPriority?" Value="@((RequestPriority?)priority)">@priority</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" 
                           Label="Location" 
                           Value="_selectedLocation" 
                           ValueChanged="OnLocationChanged" 
                           Clearable="true"
                           OnClearButtonClick="OnLocationCleared">
                    <MudSelectItem T="string" Value="@(null)">All Locations</MudSelectItem>
                    @foreach (var loc in _locations)
                    {
                        <MudSelectItem T="string" Value="@loc">@loc</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Secondary" 
                           StartIcon="@Icons.Material.Filled.FilterAltOff" 
                           OnClick="ResetFilters">Reset</MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add" 
                           OnClick="@(() => NavigationManager.NavigateTo("/requests/create"))">Create Request</MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<MudTable T="ReplenishmentRequestDto" 
          ServerData="ServerReload" 
          @ref="_table" 
          Dense="true" 
          Hover="true" 
          Bordered="false" 
          Striped="true" 
          Elevation="2"
          RowClass="cursor-pointer"
          OnRowClick="OnRowClick">
    <HeaderContent>
        <MudTh>Request #</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Priority</MudTh>
        <MudTh>Location</MudTh>
        <MudTh>Requested By</MudTh>
        <MudTh>Requested Date</MudTh>
        <MudTh Style="text-align: right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Request #">
            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.RequestNumber</MudText>
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small" Variant="Variant.Filled">
                @context.Status
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Priority">
            <MudChip T="string" Color="@GetPriorityColor(context.Priority)" Size="Size.Small" Variant="Variant.Outlined">
                @context.Priority
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Location">
            <MudText Typo="Typo.body2">@context.StockLocationCode - @context.StockLocationName</MudText>
        </MudTd>
        <MudTd DataLabel="Requested By">
            <MudText Typo="Typo.body2">@context.RequestedBy</MudText>
        </MudTd>
        <MudTd DataLabel="Requested Date">
            <MudText Typo="Typo.body2">@context.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
        </MudTd>
        <MudTd DataLabel="Actions" Style="text-align: right">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                           Color="Color.Primary" 
                           Size="Size.Small" 
                           aria-label="View Details"
                           OnClick="@(() => NavigationManager.NavigateTo($"/requests/{context.Id}"))" />
            <AuthorizeView Roles="Worker" Context="authContext">
                @if (string.Equals(context.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                   Color="Color.Secondary" 
                                   Size="Size.Small" 
                                   aria-label="Edit Request"
                                   OnClick="@(() => NavigationManager.NavigateTo($"/requests/{context.Id}/edit"))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Send" 
                                   Color="Color.Info" 
                                   Size="Size.Small" 
                                   aria-label="Submit Request"
                                   Title="Submit this request for approval" />
                }
            </AuthorizeView>
            <AuthorizeView Roles="Reviewer" Context="authContext">
                @if (string.Equals(context.Status, "Submitted", StringComparison.OrdinalIgnoreCase))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" 
                                   Color="Color.Success" 
                                   Size="Size.Small" 
                                   aria-label="Approve Request"
                                   Title="Approve this request" />
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" 
                                   Color="Color.Error" 
                                   Size="Size.Small" 
                                   aria-label="Reject Request"
                                   Title="Reject this request" />
                }
                @if (string.Equals(context.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.LocalShipping" 
                                   Color="Color.Warning" 
                                   Size="Size.Small" 
                                   aria-label="Fulfill Request"
                                   Title="Mark request as fulfilled" />
                }
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="py-4">No replenishment requests found matching the criteria.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="py-4">Loading requests...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="Rows per page:" PageSizeOptions="new int[] { 5, 10, 20, 50 }" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<ReplenishmentRequestDto> _table = null!;
    private string? _searchTerm;
    private RequestStatus? _selectedStatus;
    private RequestPriority? _selectedPriority;
    private string? _selectedLocation;
    private List<string> _locations = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var locations = await Http.GetFromJsonAsync<List<string>>("/api/replenishmentrequests/locations");
            if (locations != null)
            {
                _locations = locations;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load locations: {ex.Message}", Severity.Warning);
        }
    }

    private async Task<TableData<ReplenishmentRequestDto>> ServerReload(TableState state, CancellationToken token)
    {
        try
        {
            var queryParams = new List<string>
            {
                $"page={state.Page + 1}",
                $"pageSize={state.PageSize}"
            };

            if (_selectedStatus.HasValue)
            {
                queryParams.Add($"status={_selectedStatus.Value}");
            }

            if (_selectedPriority.HasValue)
            {
                queryParams.Add($"priority={_selectedPriority.Value}");
            }

            if (!string.IsNullOrWhiteSpace(_selectedLocation))
            {
                queryParams.Add($"stockLocationCode={Uri.EscapeDataString(_selectedLocation)}");
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                queryParams.Add($"searchTerm={Uri.EscapeDataString(_searchTerm)}");
            }

            var url = $"/api/replenishmentrequests?{string.Join("&", queryParams)}";
            var result = await Http.GetFromJsonAsync<PagedResultDto<ReplenishmentRequestDto>>(url, token);

            if (result != null)
            {
                return new TableData<ReplenishmentRequestDto>()
                {
                    TotalItems = result.TotalCount,
                    Items = result.Items
                };
            }
        }
        catch (OperationCanceledException)
        {
            // Request was cancelled, ignore
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading requests: {ex.Message}", Severity.Error);
        }

        return new TableData<ReplenishmentRequestDto>()
        {
            TotalItems = 0,
            Items = new List<ReplenishmentRequestDto>()
        };
    }

    private void OnRowClick(TableRowClickEventArgs<ReplenishmentRequestDto> args)
    {
        if (args.Item != null)
        {
            NavigationManager.NavigateTo($"/requests/{args.Item.Id}");
        }
    }

    private async Task OnStatusChanged(RequestStatus? status)
    {
        _selectedStatus = status;
        await _table.ReloadServerData();
    }

    private async Task OnStatusCleared()
    {
        _selectedStatus = null;
        await _table.ReloadServerData();
    }

    private async Task OnPriorityChanged(RequestPriority? priority)
    {
        _selectedPriority = priority;
        await _table.ReloadServerData();
    }

    private async Task OnPriorityCleared()
    {
        _selectedPriority = null;
        await _table.ReloadServerData();
    }

    private async Task OnLocationChanged(string? location)
    {
        _selectedLocation = location;
        await _table.ReloadServerData();
    }

    private async Task OnLocationCleared()
    {
        _selectedLocation = null;
        await _table.ReloadServerData();
    }

    private async Task OnSearchCleared()
    {
        _searchTerm = null;
        await _table.ReloadServerData();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await _table.ReloadServerData();
        }
    }

    private async Task ResetFilters()
    {
        _searchTerm = null;
        _selectedStatus = null;
        _selectedPriority = null;
        _selectedLocation = null;
        await _table.ReloadServerData();
    }

    private Color GetStatusColor(string status) => status?.ToLowerInvariant() switch
    {
        "draft" => Color.Default,
        "submitted" => Color.Info,
        "approved" => Color.Success,
        "rejected" => Color.Error,
        "fulfilled" => Color.Dark,
        _ => Color.Default
    };

    private Color GetPriorityColor(string priority) => priority?.ToLowerInvariant() switch
    {
        "low" => Color.Default,
        "normal" => Color.Info,
        "urgent" => Color.Error,
        _ => Color.Default
    };
}

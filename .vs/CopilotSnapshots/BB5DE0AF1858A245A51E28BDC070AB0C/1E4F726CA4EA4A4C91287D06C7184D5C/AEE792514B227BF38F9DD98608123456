@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<CascadingAuthenticationState>
    <MudLayout>
        <MudAppBar Elevation="1" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ml-3">METS - Stock Replenishment Request System</MudText>
            <MudSpacer />
            <AuthorizeView>
                <Authorized>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudChip Icon="@Icons.Material.Filled.Person" Color="Color.Tertiary" Text="@GetUserDisplay()" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="HandleLogout" Title="Logout" />
                    </MudStack>
                </Authorized>
            </AuthorizeView>
        </MudAppBar>

        <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
            <MudDrawerHeader>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Navigation</MudText>
            </MudDrawerHeader>
            <AuthorizeView>
                <Authorized>
                    <MudNavMenu>
                        <MudNavLink Href="/requests" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.List">Requests</MudNavLink>
                        <AuthorizeView Roles="Worker">
                            <MudNavLink Href="/requests/create" Icon="@Icons.Material.Filled.AddCircle">Create Request</MudNavLink>
                        </AuthorizeView>
                    </MudNavMenu>
                </Authorized>
            </AuthorizeView>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</CascadingAuthenticationState>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private bool _drawerOpen = true;
    private ClaimsPrincipal? user;
    private IEnumerable<string> userRoles = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;
            user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                userRoles = user.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
            }
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private string GetUserDisplay()
    {
        if (user?.Identity?.Name != null)
        {
            var roleDisplay = userRoles.FirstOrDefault() ?? "Unknown";
            return $"{user.Identity.Name} ({roleDisplay})";
        }
        return "Anonymous";
    }

    private async Task HandleLogout()
    {
        try
        {
            using var client = new HttpClient();
            var baseUri = new Uri(new NavigationManager().BaseUri);
            await client.PostAsync(new Uri(baseUri, "/api/auth/logout"), null);
        }
        catch { }

        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}

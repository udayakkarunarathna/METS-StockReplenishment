using METS.StockReplenishment.Core.DTOs;
using METS.StockReplenishment.Core.Enums;
using METS.StockReplenishment.Core.Exceptions;
using METS.StockReplenishment.Core.Interfaces;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace METS.StockReplenishment.Web.Controllers;

[ApiController]
[Route("api/[controller]")]
public class ReplenishmentRequestsController : ControllerBase
{
    private readonly IReplenishmentRequestService _service;

    public ReplenishmentRequestsController(IReplenishmentRequestService service)
    {
        _service = service;
    }

    /// <summary>
    /// Gets a paged list of replenishment requests filtered by status, priority, stock location code, article number,
    /// and an optional search term.
    /// </summary>
    /// <param name="status">Filter by request status; null to include all statuses.</param>
    /// <param name="priority">Filter by request priority; null to include all priorities.</param>
    /// <param name="stockLocationCode">Filter by stock location code; null to include all locations.</param>
    /// <param name="articleNumber">Filter by article number; null to include all articles.</param>
    /// <param name="searchTerm">Free-text search applied to relevant request fields; null or empty to disable.</param>
    /// <param name="page">Page number (1-based).</param>
    /// <param name="pageSize">Number of items per page.</param>
    /// <returns>An ActionResult containing a PagedResultDto of ReplenishmentRequestDto that matches the specified filters.</returns>
    [HttpGet]
    [Authorize(Roles = "Worker,Reviewer")]
	[ProducesResponseType(typeof(PagedResultDto<ReplenishmentRequestDto>), StatusCodes.Status200OK)]
    public async Task<ActionResult<PagedResultDto<ReplenishmentRequestDto>>> GetAll(
        [FromQuery] RequestStatus? status,
        [FromQuery] RequestPriority? priority,
        [FromQuery] string? stockLocationCode,
        [FromQuery] string? articleNumber,
        [FromQuery] string? searchTerm,
        [FromQuery] int page = 1,
        [FromQuery] int pageSize = 10)
    {
        var filter = new RequestFilterDto
        {
            Status = status,
            Priority = priority,
            StockLocationCode = stockLocationCode,
            ArticleNumber = articleNumber,
            SearchTerm = searchTerm,
            Page = page,
            PageSize = pageSize
        };

        var result = await _service.GetFilteredAsync(filter);
        return Ok(result);
    }

    /// <summary>
    /// Gets the replenishment request with the specified identifier.
    /// </summary>
    /// <remarks>Requires Worker or Reviewer role. Returns 200 with the DTO on success; 404 if the request
    /// does not exist.</remarks>
    /// <param name="id">The identifier of the replenishment request.</param>
    /// <returns>An ActionResult containing the ReplenishmentRequestDto when found; NotFound (404) if not found.</returns>
    [HttpGet("{id:int}")]
	[Authorize(Roles = "Worker,Reviewer")]
	[ProducesResponseType(typeof(ReplenishmentRequestDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<ReplenishmentRequestDto>> GetById(int id)
    {
        try
        {
            var result = await _service.GetByIdAsync(id);
            return Ok(result);
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { error = ex.Message });
        }
    }

    /// <summary>
    /// Creates a new replenishment request and returns the created resource.
    /// </summary>
    /// <remarks>RequestedBy is set from User.Identity before model validation and removed from ModelState so
    /// the server-provided value is enforced.</remarks>
    /// <param name="dto">Replenishment request details; RequestedBy is populated from the authenticated user's identity.</param>
    /// <returns>201 Created with the created ReplenishmentRequestDto and a Location header pointing to GetById. Returns 400 Bad
    /// Request if validation fails.</returns>
    [HttpPost]
    [Authorize(Roles = "Worker")]
    [ProducesResponseType(typeof(ReplenishmentRequestDto), StatusCodes.Status201Created)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    public async Task<ActionResult<ReplenishmentRequestDto>> Create(
        [FromBody] CreateReplenishmentRequestDto dto)
    {
        dto.RequestedBy = User.Identity?.Name ?? string.Empty;
        ModelState.Remove(nameof(CreateReplenishmentRequestDto.RequestedBy));

        if (!TryValidateModel(dto))
            return BadRequest(ModelState);

        var result = await _service.CreateAsync(dto);
        return CreatedAtAction(nameof(GetById), new { id = result.Id }, result);
    }

    /// <summary>
    /// Updates an existing replenishment request identified by the specified id using the provided DTO.
    /// </summary>
    /// <remarks>Requires Worker role authorization. Validates model state and maps NotFoundException to 404
    /// and BusinessRuleException to 400.</remarks>
    /// <param name="id">Identifier of the replenishment request to update.</param>
    /// <param name="dto">Updated values for the replenishment request.</param>
    /// <returns>ActionResult containing the updated ReplenishmentRequestDto. Produces 200 on success, 400 for validation or
    /// business rule failures, and 404 if the request is not found.</returns>
    [HttpPut("{id:int}")]
    [Authorize(Roles = "Worker")]
    [ProducesResponseType(typeof(ReplenishmentRequestDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<ReplenishmentRequestDto>> Update(
        int id, [FromBody] UpdateReplenishmentRequestDto dto)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        try
        {
            var result = await _service.UpdateAsync(id, dto);
            return Ok(result);
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { error = ex.Message });
        }
        catch (BusinessRuleException ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }

    /// <summary>
    /// Submits the replenishment request identified by the specified id.
    /// </summary>
    /// <remarks>Requires authorization with role 'Worker'. Maps NotFoundException to 404 Not Found and
    /// BusinessRuleException to 400 Bad Request.</remarks>
    /// <param name="id">Identifier of the replenishment request to submit.</param>
    /// <returns>ActionResult containing the submitted ReplenishmentRequestDto on success (200 OK); 404 Not Found if the request
    /// does not exist; 400 Bad Request for business rule violations.</returns>
    [HttpPost("{id:int}/submit")]
    [Authorize(Roles = "Worker")]
    [ProducesResponseType(typeof(ReplenishmentRequestDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<ReplenishmentRequestDto>> Submit(int id)
    {
        try
        {
            var result = await _service.SubmitAsync(id);
            return Ok(result);
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { error = ex.Message });
        }
        catch (BusinessRuleException ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }

    /// <summary>
    /// Approves the replenishment request identified by id and returns the updated request.
    /// </summary>
    /// <remarks>Requires the Reviewer role. Returns 200 with the updated request, 400 for validation or
    /// business-rule failures, and 404 if the request is not found.</remarks>
    /// <param name="id">Identifier of the replenishment request to approve.</param>
    /// <param name="dto">Approval details supplied in the request body.</param>
    /// <returns>The updated ReplenishmentRequestDto when the request is approved.</returns>
    [HttpPost("{id:int}/approve")]
    [Authorize(Roles = "Reviewer")]
    [ProducesResponseType(typeof(ReplenishmentRequestDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<ReplenishmentRequestDto>> Approve(
        int id, [FromBody] ApproveRequestDto dto)
    {
        dto.ReviewedBy = User.Identity?.Name ?? string.Empty;

        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        try
        {
            var result = await _service.ApproveAsync(id, dto);
            return Ok(result);
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { error = ex.Message });
        }
        catch (BusinessRuleException ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }

    /// <summary>
    /// Rejects the replenishment request with the specified id and returns the updated request.
    /// </summary>
    /// <remarks>Requires the Reviewer role. Validates the model and maps NotFoundException to 404 and
    /// BusinessRuleException to 400.</remarks>
    /// <param name="id">Identifier of the replenishment request to reject.</param>
    /// <param name="dto">Rejection details such as reason; ReviewedBy is populated with the current user's name before processing.</param>
    /// <returns>The updated ReplenishmentRequestDto when the request is successfully rejected. Returns 400 for validation or
    /// business-rule errors and 404 if the request is not found.</returns>
    [HttpPost("{id:int}/reject")]
    [Authorize(Roles = "Reviewer")]
    [ProducesResponseType(typeof(ReplenishmentRequestDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<ReplenishmentRequestDto>> Reject(
        int id, [FromBody] RejectRequestDto dto)
    {
        dto.ReviewedBy = User.Identity?.Name ?? string.Empty;

        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        try
        {
            var result = await _service.RejectAsync(id, dto);
            return Ok(result);
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { error = ex.Message });
        }
        catch (BusinessRuleException ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }

    /// <summary>
    /// Fulfills the replenishment request identified by the specified id and returns the updated
    /// ReplenishmentRequestDto.
    /// </summary>
    /// <remarks>Requires Reviewer role. Validates model state and maps business-rule violations to 400
    /// responses.</remarks>
    /// <param name="id">Identifier of the replenishment request to fulfill.</param>
    /// <param name="dto">Fulfillment details.</param>
    /// <returns>200 OK with the updated ReplenishmentRequestDto on success; 400 Bad Request for validation or business-rule
    /// errors; 404 Not Found if the request does not exist.</returns>
    [HttpPost("{id:int}/fulfill")]
	[Authorize(Roles = "Reviewer")]
	[ProducesResponseType(typeof(ReplenishmentRequestDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status400BadRequest)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<ReplenishmentRequestDto>> Fulfill(
        int id, [FromBody] FulfillRequestDto dto)
    {
        if (!ModelState.IsValid)
            return BadRequest(ModelState);

        try
        {
            var result = await _service.FulfillAsync(id, dto);
            return Ok(result);
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { error = ex.Message });
        }
        catch (BusinessRuleException ex)
        {
            return BadRequest(new { error = ex.Message });
        }
    }

    /// <summary>
    /// Gets the stock validation status for the item with the specified identifier.
    /// </summary>
    /// <remarks>Requires authorization as Worker or Reviewer. Returns 404 when the item is not
    /// found.</remarks>
    /// <param name="id">The identifier of the item to validate stock for.</param>
    /// <returns>A 200 OK response containing a StockValidationResultDto when the item exists; otherwise a 404 NotFound response.</returns>
    [HttpGet("{id:int}/stock-validation")]
	[Authorize(Roles = "Worker,Reviewer")]
	[ProducesResponseType(typeof(StockValidationResultDto), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<StockValidationResultDto>> GetStockValidation(int id)
    {
        try
        {
            var result = await _service.GetStockValidationStatusAsync(id);
            return Ok(result);
        }
        catch (NotFoundException ex)
        {
            return NotFound(new { error = ex.Message });
        }
    }

    /// <summary>
    /// Gets distinct location names.
    /// </summary>
    /// <remarks>Requires authentication with the Worker or Reviewer role. Retrieves the locations
    /// asynchronously from the underlying service.</remarks>
    /// <returns>An ActionResult containing a list of distinct location names. Returns 200 OK with the list when successful.</returns>
    [HttpGet("locations")]
	[Authorize(Roles = "Worker,Reviewer")]
	[ProducesResponseType(typeof(List<string>), StatusCodes.Status200OK)]
    public async Task<ActionResult<List<string>>> GetLocations()
    {
        var result = await _service.GetDistinctLocationsAsync();
        return Ok(result);
    }

    /// <summary>
    /// Retrieves distinct stock location options.
    /// </summary>
    /// <remarks>Requires authentication and authorization for the Worker or Reviewer roles; results are
    /// obtained asynchronously from the underlying service.</remarks>
    /// <returns>An ActionResult containing a list of StockLocationOptionDto with a 200 OK response when successful.</returns>
    [HttpGet("location-options")]
	[Authorize(Roles = "Worker,Reviewer")]
	[ProducesResponseType(typeof(List<StockLocationOptionDto>), StatusCodes.Status200OK)]
    public async Task<ActionResult<List<StockLocationOptionDto>>> GetLocationOptions()
    {
        var result = await _service.GetDistinctLocationOptionsAsync();
        return Ok(result);
    }

    /// <summary>
    /// Asynchronously retrieves distinct article options for callers in the Worker or Reviewer roles.
    /// </summary>
    /// <remarks>Accessible via HTTP GET at 'article-options' and requires authorization as Worker or
    /// Reviewer.</remarks>
    /// <returns>An ActionResult containing a list of ArticleOptionDto with the distinct article options.</returns>
    [HttpGet("article-options")]
	[Authorize(Roles = "Worker,Reviewer")]
	[ProducesResponseType(typeof(List<ArticleOptionDto>), StatusCodes.Status200OK)]
    public async Task<ActionResult<List<ArticleOptionDto>>> GetArticleOptions()
    {
        var result = await _service.GetDistinctArticleOptionsAsync();
        return Ok(result);
    }
}
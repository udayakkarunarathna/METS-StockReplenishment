using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;

namespace METS.StockReplenishment.Web.Controllers;


/// <summary>
/// API controller that handles user authentication operations such as login, logout, and retrieving the current
/// authenticated user.
/// </summary>
/// <remarks>Configured at route "api/[controller]" and uses ASP.NET Core Identity's UserManager and
/// SignInManager. Exposes POST "login" (validates credentials), POST "logout" (signs out via
/// IdentityConstants.ApplicationScheme), and GET "current-user" (returns authentication state, username, email, and
/// roles). Login and logout endpoints ignore antiforgery tokens.</remarks>
[ApiController]
[Route("api/[controller]")]
public class AuthController : ControllerBase
{
	private readonly SignInManager<IdentityUser> _signInManager;
	private readonly UserManager<IdentityUser> _userManager;

	public AuthController(SignInManager<IdentityUser> signInManager, UserManager<IdentityUser> userManager)
	{
		_signInManager = signInManager;
		_userManager = userManager;
	}


	/// <summary>
	/// Authenticate a user by validating the provided username and password and return an appropriate IActionResult.
	/// </summary>
	/// <remarks>Handles HTTP POST at the "login" route and ignores antiforgery tokens.</remarks>
	/// <param name="request">LoginRequest containing the username and password to authenticate.</param>
	/// <returns>An IActionResult: BadRequest if username or password is missing, Unauthorized if credentials are invalid, or Ok
	/// with a success message and the authenticated username on success.</returns>
	[HttpPost("login")]
	[IgnoreAntiforgeryToken]
	public async Task<IActionResult> Login([FromBody] LoginRequest request)
	{
		if (string.IsNullOrEmpty(request.Username) || string.IsNullOrEmpty(request.Password))
		{
			return BadRequest(new { message = "Username and password are required" });
		}

		var user = await _userManager.FindByNameAsync(request.Username);
		if (user == null)
		{
			return Unauthorized(new { message = "Invalid username or password" });
		}

		var result = await _signInManager.CheckPasswordSignInAsync(user, request.Password, false);
		if (!result.Succeeded)
		{
			return Unauthorized(new { message = "Invalid username or password" });
		}

		return Ok(new { message = "Login successful", username = user.UserName });
	}


	/// <summary>
	/// Signs out the currently authenticated user from the Identity application authentication scheme.
	/// </summary>
	/// <remarks>Responds to HTTP POST at route logout and ignores antiforgery tokens. Calls
	/// HttpContext.SignOutAsync with IdentityConstants.ApplicationScheme.</remarks>
	/// <returns>An OkObjectResult (HTTP 200) containing an anonymous object with a success message.</returns>
	[HttpPost("logout")]
	[IgnoreAntiforgeryToken]
	public async Task<IActionResult> Logout()
	{
		await HttpContext.SignOutAsync(IdentityConstants.ApplicationScheme);
		return Ok(new { message = "Logout successful" });
	}

	/// <summary>
	/// Gets the currently authenticated user's information including an authentication flag, username, email, and roles.
	/// </summary>
	/// <remarks>Resolves the user from the current ClaimsPrincipal via UserManager and retrieves roles
	/// asynchronously.</remarks>
	/// <returns>An IActionResult that returns 200 OK with a JSON object: when unauthenticated { isAuthenticated = false }; when
	/// authenticated { isAuthenticated = true, username, email, roles }.</returns>
	[HttpGet("current-user")]
	public async Task<IActionResult> GetCurrentUser()
	{
		var user = await _userManager.GetUserAsync(User);
		if (user == null)
		{
			return Ok(new { isAuthenticated = false });
		}

		var roles = await _userManager.GetRolesAsync(user);
		return Ok(new
		{
			isAuthenticated = true,
			username = user.UserName,
			email = user.Email,
			roles = roles
		});
	}
}

public class LoginRequest
{
	public string Username { get; set; } = string.Empty;
	public string Password { get; set; } = string.Empty;
}
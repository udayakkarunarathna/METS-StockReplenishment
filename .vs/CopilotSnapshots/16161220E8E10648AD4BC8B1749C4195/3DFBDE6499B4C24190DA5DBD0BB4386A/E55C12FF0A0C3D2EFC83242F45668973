@page "/requests/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using METS.StockReplenishment.Core.Exceptions
@using METS.StockReplenishment.Core.Interfaces
@attribute [Authorize(Roles = "Worker")]
@inject IReplenishmentRequestService ReplenishmentRequestService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Create Replenishment Request</PageTitle>

<div class="d-flex align-center mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/"))" aria-label="Back" Class="mr-2" />
    <MudText Typo="Typo.h5">Create Replenishment Request</MudText>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
        @_errorMessage
    </MudAlert>
}

<EditForm Model="@_model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <MudGrid Spacing="3">
        <!-- Request Details Card -->
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Request Details</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="9">
                            <MudSelect T="string"
                                       Label="Stock Location"
                                       Value="_selectedLocationCode"
                                       ValueChanged="OnLocationChanged"
                                       Required="true"
                                       RequiredError="Stock location is required"
                                       Placeholder="Select a stock location">
                                @foreach (var location in _stockLocations)
                                {
                                    <MudSelectItem Value="@location.Code">@location.Code - @location.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="RequestPriority" 
                                       @bind-Value="_model.Priority" 
                                       For="@(() => _model.Priority)"
                                       Label="Priority">
                                @foreach (var priority in Enum.GetValues<RequestPriority>())
                                {
                                    <MudSelectItem Value="@priority">@priority</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Line Items Card -->
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.h6">Line Items</MudText>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       StartIcon="@Icons.Material.Filled.Add" 
                                       Size="Size.Small" 
                                       OnClick="AddLineItem">
                                Add Item
                            </MudButton>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (!_model.LineItems.Any())
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            Please add at least one line item to this request.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_model.LineItems" Dense="true" Elevation="0" Striped="true">
                            <HeaderContent>
                                <MudTh Style="width: 50px;">#</MudTh>
                                <MudTh>Article</MudTh>
                                <MudTh Style="width: 180px; text-align: right">Requested Quantity</MudTh>
                                <MudTh Style="width: 80px; text-align: center">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="lineItem">
                                <MudTd DataLabel="#">@(_model.LineItems.IndexOf(lineItem) + 1)</MudTd>
                                <MudTd DataLabel="Article">
                                    <MudSelect T="string"
                                               Value="lineItem.ArticleNumber"
                                               ValueChanged="@(value => OnArticleChanged(lineItem, value))"
                                               Required="true"
                                               RequiredError="Article is required"
                                               Placeholder="Select an article"
                                               Margin="Margin.Dense">
                                        @foreach (var article in _articleOptions)
                                        {
                                            <MudSelectItem Value="@article.ArticleNumber">@article.ArticleNumber - @article.Description</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd DataLabel="Requested Quantity" Style="text-align: right">
                                    <MudNumericField @bind-Value="lineItem.RequestedQuantity" 
                                                     Min="0.01m" 
                                                     Step="1m" 
                                                     Format="F2" 
                                                     Margin="Margin.Dense" />
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   Color="Color.Error" 
                                                   Size="Size.Small" 
                                                   OnClick="@(() => RemoveLineItem(lineItem))" 
                                                   aria-label="Remove Item" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudCardContent>
                <MudCardActions Class="d-flex justify-space-between pa-4">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Secondary" 
                               OnClick="@(() => NavigationManager.NavigateTo("/"))">
                        Cancel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Save" 
                               Disabled="@_isSaving" 
                               ButtonType="ButtonType.Submit">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>Create Request</span>
                        }
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private CreateReplenishmentRequestDto _model = new();
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _selectedLocationCode;
    private List<StockLocationOptionDto> _stockLocations = new();
    private List<ArticleOptionDto> _articleOptions = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _model.RequestedBy = authState.User.Identity?.Name ?? string.Empty;

        // Add default line item
        AddLineItem();

        try
        {
            _stockLocations = await ReplenishmentRequestService.GetDistinctLocationOptionsAsync();
            _articleOptions = await ReplenishmentRequestService.GetDistinctArticleOptionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load dropdown options: {ex.Message}", Severity.Warning);
        }
    }

    private Task OnLocationChanged(string? code)
    {
        _selectedLocationCode = code;

        var selectedLocation = _stockLocations.FirstOrDefault(l => l.Code == code);
        _model.StockLocationCode = selectedLocation?.Code ?? string.Empty;
        _model.StockLocationName = selectedLocation?.Name ?? string.Empty;

        return Task.CompletedTask;
    }

    private void AddLineItem()
    {
        _model.LineItems.Add(new CreateLineItemDto
        {
            ArticleNumber = string.Empty,
            Description = string.Empty,
            RequestedQuantity = 1.00m
        });
    }

    private void OnArticleChanged(CreateLineItemDto lineItem, string? articleNumber)
    {
        lineItem.ArticleNumber = articleNumber ?? string.Empty;

        var selectedArticle = _articleOptions.FirstOrDefault(a => a.ArticleNumber == articleNumber);
        lineItem.Description = selectedArticle?.Description ?? string.Empty;
    }

    private void RemoveLineItem(CreateLineItemDto item)
    {
        if (_model.LineItems.Count > 1)
        {
            _model.LineItems.Remove(item);
        }
        else
        {
            Snackbar.Add("A request must contain at least one line item.", Severity.Warning);
        }
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        // Custom validation
        if (string.IsNullOrWhiteSpace(_model.StockLocationCode) || string.IsNullOrWhiteSpace(_model.StockLocationName))
        {
            _errorMessage = "Stock location is required.";
            return;
        }

        if (!_model.LineItems.Any())
        {
            _errorMessage = "At least one line item is required.";
            return;
        }

        for (int i = 0; i < _model.LineItems.Count; i++)
        {
            var item = _model.LineItems[i];
            if (string.IsNullOrWhiteSpace(item.ArticleNumber))
            {
                _errorMessage = $"Line item #{i + 1}: Article Number is required.";
                return;
            }
            if (string.IsNullOrWhiteSpace(item.Description))
            {
                _errorMessage = $"Line item #{i + 1}: Description is required.";
                return;
            }
            if (item.RequestedQuantity <= 0)
            {
                _errorMessage = $"Line item #{i + 1}: Requested quantity must be greater than zero.";
                return;
            }
        }

        _isSaving = true;

        try
        {
            var created = await ReplenishmentRequestService.CreateAsync(_model);
            Snackbar.Add($"Request #{created.RequestNumber} created successfully!", Severity.Success);
            NavigationManager.NavigateTo($"/requests/{created.Id}");
        }
        catch (BusinessRuleException ex)
        {
            _errorMessage = ex.Message;
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        catch (Exception ex)
        {
            _errorMessage = $"An unexpected error occurred: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

}
